utus\" data-bs-toggle=\"collapse\" aria-expanded=\"false\" aria-controls=\"aboutus\"> Corporate <svg class=\"arrowDown\" width=\"1.5em\" height=\"1.5em\" aria-hidden=\"true\" focusable=\"false\"> <path d=\"M6.99 9.16a.6.6 0 00-.4-.16.6.6 0 00-.42.16.5.5 0 00-.17.37c0 .14.07.28.17.37l5.45 4.92c.04.06.09.1.15.15.14.05.3.05.44 0a.6.6 0 00.18-.11l5.45-4.92a.5.5 0 00.16-.37.5.5 0 00-.16-.37.6.6 0 00-.41-.16.6.6 0 00-.41.16l-5.03 4.46-5-4.5z\"></path> </svg> </a>\r\n<ul id=\"aboutus\" class=\"footer-link collapse\">\r\n<li><a href=\"https://business.ticketmaster.sg\" target=\"_blank\" rel=\"noopener\">Who We Are</a></li>\r\n<li><a href=\"https://livenation.wd503.myworkdayjobs.com/en/TMExternalSite\" target=\"_blank\" rel=\"noopener\">Careers</a></li>\r\n<li><a href=\"https://www.ticketmaster.com/international\" target=\"_blank\" rel=\"noopener\">Across The Globe</a></li>\r\n</ul>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n<div class=\"copyright row no-gutters\">\r\n<div class=\"sitemap col-lg-6 col-md-6 col-sm-12 col-xs-12 col-12\"><a href=\"/purchase\">Purchase Policy</a> | <a href=\"https://privacy.ticketmaster.sg/privacy-policy\">Privacy Policy</a> | <a href=\"https://privacy.ticketmaster.sg/cookie-policy\">Cookies</a></div>\r\n<div class=\"copyrightLabel col-lg-6 col-md-6 col-sm-12 col-xs-12 col-12\">&copy; 1999-2026 Ticketmaster. All rights reserved.</div>\r\n</div>\r\n<!-- Fastly EPS -->\r\n<p>\r\n<script async=\"\" src=\"/eps-mgr\" type=\"text/javascript\"></script>\r\n</p>\r\n<!-- End Fastly EPS Code -->        </div>\n    </footer>\n</div>\n<script src=\"//cdnjs.cloudflare.com/ajax/libs/moment.js/2.30.1/moment.min.js\" crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\" integrity=\"sha512-QoJS4DOhdmG8kbbHkxmB/rtPdN62cGWXAdAFWWJPvUFF1/zxcPSdAnn4HhYZSIlVoLVEJ0LesfNlusgm2bPfnA==\"></script>\n<script src=\"/js/daterangepicker-buddhist-year.js?v=1\" crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\"></script>\n<script src=\"/js/queue-it/queueclient.min.js\"></script>\n<script src=\"/js/queue-it/queueconfigloader.min.js\" data-queueit-intercept-domain=\"ticketmaster.sg\" data-queueit-intercept=\"true\" data-queueit-c=\"ticketmasterasia\"></script>\n<script>\njQuery(document).ready(function() {\n    /* category dropdown */\n    jQuery(\"#Categories\").on(\"click\", function() {\n        if (jQuery(this).hasClass(\"opened-menu\")) {\n            jQuery(this).removeClass(\"opened-menu\");\n            jQuery(\".catList\").css(\"display\", \"none\");\n        } else {\n            jQuery(\".catList\").css(\"display\", \"flex\");\n            jQuery(this).addClass(\"opened-menu\");\n        }\n    });\n    jQuery(\"#Categories\").mouseenter(function() {\n        var x = jQuery(this).offset().left;\n        var y = jQuery(this).offset().top;\n        jQuery(this).addClass(\"opened-menu\");\n        jQuery(\".catList\").slideDown(\"fast\").css(\"display\", \"flex\");\n    });\n    jQuery(\"#Categories\").mouseleave(function(e) {\n        jQuery(\".catList\").hide();\n        jQuery(this).removeClass(\"opened-menu\");\n    });\n    /* MORE button on smaller screen */\n    jQuery(\"#moreMenu\").on(\"touchend\", function(e) {\n        if (!jQuery(e.target).parent().find(\"#megaMenuContainer a\").length) {\n            //do nothing\n        } else {\n            if (jQuery(this).hasClass(\"opened-menu\")) {\n                jQuery(this).removeClass(\"opened-menu\");\n                jQuery(\"#megaMenuContainer\").slideUp(\"slow\").css(\"display\", \"none\");\n            } else {\n                jQuery(\"#megaMenuContainer\").slideDown(\"fast\").css(\"display\", \"flex\");\n                jQuery(this).addClass(\"opened-menu\");\n            }\n        }\n    });\n    jQuery(\"#moreMenu\").mouseenter(function() {\n        var x = jQuery(this).offset().left;\n        var y = jQuery(this).offset().top;\n        jQuery(this).addClass(\"opened-menu\");\n        jQuery(\"#megaMenuContainer\").slideDown(\"fast\").css(\"display\", \"flex\");\n    });\n\n    jQuery(\"#moreMenu\").mouseleave(function(e) {\n        jQuery(\"#megaMenuContainer\").hide();\n        jQuery(this).removeClass(\"opened-menu\");\n    });\n    /* news height */\n    var sameHeightTop = jQuery(\".eqParent\");\n    if (sameHeightTop.length !== 0) {\n        sameHeightTop.each(function () {\n            var tallest = 0;\n            var sameHeightChildren = jQuery(this).find(\".eqChild\");\n            sameHeightChildren.each(function () {\n                var thisHeight = jQuery(this).height();\n                if (thisHeight > tallest) {\n                    tallest = thisHeight;\n                }\n            });\n            sameHeightChildren.height(tallest);\n        });\n    }\n    /* footer quickLinks */\n    jQuery(\"#quickLinks a\").click(function(event) {\n        jQuery(\"#quickLinks\").collapse(\"hide\");\n    });\n    jQuery(\".systempageContainer a[href^='\\#'\\]\").on(\"click\", function(event) {\n        if (this.hash !== \"\") {\n            event.preventDefault();\n            var hash = this.hash;\n            jQuery(\"html, body\").animate({\n                scrollTop: jQuery(hash).offset().top\n            }, 800, function() {\n                window.location.hash = hash;\n            });\n        }\n    });\n});\n\n\n/* open/close Region / Language sidebar*/\nfunction toggle_menu(menuType) {\n    jQuery(\".countryList button\").removeClass(\"currentSelected\");\n    jQuery(\".countryList\").removeClass(\"opened\");\n    jQuery(\"#languageList\").removeClass(\"d-none\");\n     jQuery(\"#overseasList\").removeClass(\"d-none\");\n\n    if (menuType == \"lang\") {\n        jQuery(\"#overseasList\").prev().find(\".chZcwd\").css(\"transform\", \"none\");\n        jQuery(\"#languageList\").prev().find(\".chZcwd\").css(\"transform\", \"rotate(180deg)\");\n        var e = document.getElementById(\"myLoc\");\n        if (e.classList.contains(\"showing\")) {\n          e.classList.remove(\"showing\");\n          document.getElementById(\"overlayLocation\").style.display = \"none\";\n          jQuery(\"body\").removeClass(\"modal-open\");\n        } else {\n          e.classList.add(\"showing\");\n          jQuery(\"#languageList\").closest(\".countryList\").addClass(\"opened\");\n          jQuery(\"#languageList\").prev(\"button\").addClass(\"currentSelected\");\n          jQuery(\"#overseasList\").addClass(\"d-none\");\n          document.getElementById(\"overlayLocation\").style.display = \"block\";\n          jQuery(\"body\").addClass(\"modal-open\");\n        }\n    } else if (menuType == \"country\") {\n        jQuery(\"#languageList\").prev().find(\".chZcwd\").css(\"transform\", \"none\");\n        jQuery(\"#overseasList\").prev().find(\".chZcwd\").css(\"transform\", \"rotate(180deg)\");\n        var e = document.getElementById(\"myLoc\");\n        if (e.classList.contains(\"showing\")) {\n          e.classList.remove(\"showing\");\n          document.getElementById(\"overlayLocation\").style.display = \"none\";\n          jQuery(\"body\").removeClass(\"modal-open\");\n        } else {\n          e.classList.add(\"showing\");\n\n           jQuery(\"#overseasList\").closest(\".countryList\").addClass(\"opened\");\n          jQuery(\"#overseasList\").prev(\"button\").addClass(\"currentSelected\");\n          jQuery(\"#languageList\").addClass(\"d-none\");\n          document.getElementById(\"overlayLocation\").style.display = \"block\";\n          jQuery(\"body\").addClass(\"modal-open\");\n        }\n    }  else {\n        var e = document.getElementById(\"myLoc\");\n        if (e.classList.contains(\"showing\")) {\n          e.classList.remove(\"showing\");\n          document.getElementById(\"overlayLocation\").style.display = \"none\";\n          jQuery(\"body\").removeClass(\"modal-open\");\n        } else {\n          e.classList.add(\"showing\");\n          document.getElementById(\"overlayLocation\").style.display = \"block\";\n          jQuery(\"body\").addClass(\"modal-open\");\n        }\n    }\n\n}\n\n/* override menu collapse on mobile - smooth animation*/\nfunction toggle_NavMenu() {\n    if (jQuery(\"#bs-navbar2\").hasClass(\"showing\")) {\n        jQuery(\"#bs-navbar2\").removeClass(\"showing\");\n        jQuery(\"#overlayLocation\").hide();\n        jQuery(\"body\").removeClass(\"modal-open\");\n    } else {\n        jQuery(\"#bs-navbar2\").addClass(\"showing\");\n        jQuery(\"#overlayLocation\").show();\n        jQuery(\"body\").addClass(\"modal-open\");\n    }\n}\n /* close location sidebar when clicking overlay */\n    function closeNav2() {\n        jQuery(\"#myLoc\").removeClass(\"showing\");\n        jQuery(\"#bs-navbar2\").removeClass(\"showing\");//to close sidebar menu on smaller device\n        jQuery(\"body\").removeClass(\"modal-open\");\n        jQuery(\"#overlayLocation\").hide();\n    }\n/* end - put outside/before jQuery(function($) */\n</script>\n<script>jQuery(function ($) {\n\n$(window).off(\"scroll.page_show_more\");\n$(window).on(\"scroll.page_show_more\", function(){\n    if (($(window).scrollTop()+30) > $(document).height() - $(window).height()) {\n        if ($(\".page-show-more a\").length == 1) {\n            var this_element = $(\".page-show-more a:first-child\");\n            morePage(this_element);\n        }\n    }\n});\n$(document.body).off(\"click\", \".page-show-more a\");\n$(document.body).on(\"click\", \".page-show-more a\", function() {\n    morePage($(this));\n});\nfunction morePage(element) {\n    var element_parent = element.parent();\n    if (element.length != 0) {\n        var action_url = element_parent.attr(\"data-action-url\");\n        var parameter = element_parent.attr(\"data-parameter\");\n        var type = element_parent.attr(\"data-type\");\n        var offset = element_parent.attr(\"data-offset\");\n        $.ajax({\n            url: action_url + \"?\" + parameter,\n            type: \"GET\",\n            data: {\n                offset : offset\n            },\n            dataType: \"html\",\n            beforeSend: function( xhr ) {\n                $(\"#system-message\").show();\n                $(document.body).off(\"click\", \".page-show-more a\");\n                $(window).off(\"scroll.page_show_more\");\n            },\n            success: function( html_block ) {\n                element_parent.remove();\n                $(\"#activityListTab\").append(html_block);\n                $(\"#system-message\").fadeOut();\n                $(window).on(\"scroll.page_show_more\", function(){\n                    if (($(window).scrollTop()+30) > $(document).height() - $(window).height()) {\n                        if ($(\".page-show-more a\").length == 1) {\n                            var this_element = $(\".page-show-more a:first-child\");\n                            morePage(this_element);\n                        }\n                    }\n                });\n                $(document.body).on(\"click\", \".page-show-more a\", function() {\n                    morePage($(this));\n                });\n            }\n        });\n    }\n}\njQuery('#dateRange').closest('.input-group').daterangepicker({\"minDate\":\"20-05-2026\",\"autoUpdateInput\":false,\"locale\":{\"format\":\"DD-MM-YYYY\",\"separator\":\" ~ \",\"applyLabel\":\"Apply\",\"cancelLabel\":\"Cancel\"},\"cancelButtonClasses\":\"btn-secondary\"});\njQuery(\"#dateRange\").closest('.input-group').on('apply.daterangepicker', function(ev, picker) {\n    var startDate = encodeURI(picker.startDate.format(\"DD-MM-YYYY\"));\n    var endDate = encodeURI(picker.endDate.format(\"DD-MM-YYYY\"));\n    var type = jQuery('ul.display-type').find('li.active').data('type');\n    jQuery(this).val(startDate + ' - ' + endDate);\n    document.location.href = \"https://ticketmaster.sg/activity/concerts?type=\" + type + '&startDate=' + startDate + '&endDate=' + endDate;\n});\njQuery(\"#dateRange\").closest('.input-group').on('show.daterangepicker', function() {\n    if (jQuery('#daterangeClerbtn').length <= 0) {\n        jQuery('<button id=\"daterangeClerbtn\" class=\"btn btn-sm btn-default\">Clear</button>').insertBefore('.drp-buttons>button:first');\n        jQuery('body').on(\"click\",\"#daterangeClerbtn\", function() {\n            jQuery('#dateRange').val('');\n            document.location.href = \"https://ticketmaster.sg/activity/concerts?type=\" + jQuery('ul.display-type').find('li.active').data('type');\n        });\n    }\n});\njQuery('body').on('cancel.daterangepicker', '#dateRange', function() {\n    jQuery('#dateRange').val('');\n});\n$(window).trigger(\"resize\");\njQuery(document).ready(function() {\n    notWorkingProperlyWarning([\"/ticket/area\",\"/ticket/checkout\"], \"/html/adblock.html\");\n});\n\nfunction setErrorLog(message, category) {\n    $.post('/log/set-error-log', {\n        \"message\": message,\n        \"category\": category\n    });\n}\n\nvar goSearch = function() {\n    var url = jQuery(\".search-btn\").attr(\"data-href\"),\n        keyword = jQuery(\".searchBox input[type=text]\").val();\n    if (keyword.indexOf(\"/\") != -1) {\n        alert(\"Please do not use / in your search keywords.\");\n    } else {\n        window.location.href = url + \"/\" + keyword;\n    }\n}\njQuery(\".search-btn\").off(\"click\");\njQuery(\".search-btn\").on(\"click\", function() {\n    goSearch();\n});\njQuery(\".searchBox input[type=text]\").off(\"keydown\");\njQuery(\".searchBox input[type=text]\").on(\"keydown\", function(event) {\n    if ([13].indexOf(event.keyCode) !== -1) {\n        goSearch();\n    }\n});\n\njQuery(function() {\n    jQuery(\"li.account-login\").mouseenter(function() {\n        var x = jQuery(this).offset().left;\n        var y = jQuery(this).offset().top;\n        jQuery(\"#accountFunc\").slideDown(\"fast\");\n    });\n    jQuery(\"li.account-login\")\n    .mouseleave(function(e) {\n    jQuery(\"#accountFunc\").hide();\n    });\n    jQuery(\"li.account-login > a\").on(\"touchend\", function(e) {\n        