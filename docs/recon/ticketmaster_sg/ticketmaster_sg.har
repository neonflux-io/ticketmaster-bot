s).attr(\\\"id\\\")];\\n                if(!areaInfo || areaInfo.areaStatus == \\\"UNAVAILABLE\\\"){\\n                    $(this).addClass(\\\"empty\\\");\\n                    highlight($(this));\\n                }\\n            });\\n\\n            $(\\\"div#mapContainer\\\").off(\\\"mouseover\\\").off(\\\"mouseout\\\").off(\\\"click\\\");\\n            $(\\\"div#mapContainer\\\").on(\\\"mouseover\\\", \\\"svg>g#sections>g\\\", function(e) {\\n                var areaInfo = zone[$(this).attr(\\\"id\\\")];\\n                if ($(this).attr(\\\"id\\\") != selSec) {\\n                    highlight($(this));\\n                    if (areaInfo && areaInfo.areaStatus != \\\"UNAVAILABLE\\\") {\\n                        $(this).css({\\\"cursor\\\":\\\"pointer\\\"});\\n                        var info = \\\" Available Seats: <strong>\\\" + areaInfo.areaStatusText + \\\"</strong><br><hr>\\\" + areaInfo.description;\\n                        var x = e.pageX + 20;\\n                        var y = e.pageY;\\n                        $(\\\"div#sectionInfo\\\").css({\\n                            left: x + \\\"px\\\",\\n                            top: y + \\\"px\\\"\\n                        }).html(info);\\n                        $(\\\"div#sectionInfo\\\").show();\\n                    } else if (areaInfo || ($(this).attr(\\\"id\\\") && $(this).attr(\\\"id\\\").indexOf(\\\"field_\\\") != -1)) {\\n                        $(this).css({\\\"cursor\\\":\\\"pointer\\\"});\\n                        unhighlight($(this));\\n                        var info = \\\" Available Seats: <strong>UNAVAILABLE</strong>\\\";\\n                        var x = e.pageX + 20;\\n                        var y = e.pageY;\\n                        $(\\\"div#sectionInfo\\\").css({\\n                            left: x + \\\"px\\\",\\n                            top: y + \\\"px\\\"\\n                        }).html(info);\\n                        $(\\\"div#sectionInfo\\\").show();\\n                    } else if (!areaInfo){\\n                        $(this).css({\\\"cursor\\\":\\\"default\\\"});\\n                        unhighlight($(this));\\n                    }\\n                }\\n            }).on(\\\"mouseout\\\", \\\"svg>g#sections>g\\\", function() {\\n                var areaInfo = zone[$(this).attr(\\\"id\\\")];\\n                if( $(this).attr(\\\"id\\\") != selSec\u3000){\\n                    unhighlight($(this));\\n                    if( areaInfo\u3000&& areaInfo.areaStatus != \\\"UNAVAILABLE\\\" ){\\n                    }\\n                    else if( areaInfo || !areaInfo ){\\n                        highlight($(this));\\n                    }\\n                }\\n                $(\\\"div#sectionInfo\\\").hide();\\n            }).on(\\\"click\\\", \\\"svg>g#sections>g\\\", function() {\\n\\t\\t\\t\\t$(\\\"#mapContainer .venue-area\\\").removeClass(\\\"enlarged\\\");\\n\\t\\t\\t\\t$(\\\"#enlargeMap\\\").html(\\\"<i class=\\\\\\\"fa fa-search-plus\\\\\\\"></i>\\\");\\n\\t\\t\\t\\t$(\\\"div#sectionInfo\\\").hide();\\n                areaTicket($(this).attr(\\\"id\\\"), \\\"map\\\");\\n            });\\n\\n            if (Object.keys(zone).length == 1) {\\n                const areaId = Object.keys(zone)[0];\\n                areaTicket(areaId, \\\"map\\\");\\n            }\\n        },\\n        error: function(xhr){\\n            alert(\\\"There was a connection failure. Please contact our customer service so that we can help you.\\\");\\n            $(\\\"#mapContainer\\\").html(\\\"\\\");\\n        }\\n    });\\n}\\n\\nif (fieldImageType == imageTypeHide || fieldImageType == imageTypeFile) {\\n    $(\\\"div#mapContainer\\\").html(\\\"<img id=\\\\\\\"loadingmap\\\\\\\" src=\\\\\\\"/images/loading.GIF\\\\\\\" alt=\\\\\\\"loadingmap\\\\\\\">\\\");\\n    $.ajax({\\n        type: \\\"GET\\\",\\n        url: \\\"https://ticketmaster.sg/ticket/get-area-list/26sg_pglcs2major/3239\\\",\\n        dataType: \\\"json\\\",\\n\\n        success: function(response) {\\n            $(\\\"div#mapContainer\\\").html(response);\\n\\n            var selSec = \\\"\\\";\\n            const isSingleZone = Object.keys(zone).length == 1;\\n\\n            $(\\\"div#mapContainer\\\").off(\\\"click\\\");\\n            $(\\\"div#mapContainer\\\").on(\\\"click\\\", \\\"div>ul>li>a\\\", function() {\\n                areaTicket($(this).attr(\\\"id\\\"), \\\"list\\\");\\n            });\\n            if (isSingleZone) {\\n                $(\\\"div#mapContainer div>ul>li>a\\\").trigger(\\\"click\\\");\\n            }\\n            if (isSingleZone && fieldImageType == imageTypeHide) {\\n                $(\\\"#mapSelectArea\\\").hide();\\n            }\\n            if (isSingleZone && fieldImageType == imageTypeFile) {\\n                $(\\\".area_select\\\").hide();\\n            }\\n        },\\n        error: function(xhr){\\n            alert(\\\"There was a connection failure. Please contact our customer service so that we can help you.\\\");\\n            $(\\\"#mapContainer\\\").html(\\\"\\\");\\n        }\\n    });\\n}\\n\\nfunction colorNameToHex(color) {\\n    const ctx = document.createElement(\\\"canvas\\\").getContext(\\\"2d\\\");\\n    ctx.fillStyle = color;\\n    return ctx.fillStyle;\\n}\\n\\nfunction highlight(section){\\n    jQuery.each(section.children(), function(){\\n        var is3d = true;\\n        var fill = jQuery(this).find(\\\">:first-child\\\").attr(\\\"fill\\\");\\n        if (typeof fill === \\\"string\\\" && !fill.startsWith(\\\"#\\\")) {\\n            fill = colorNameToHex(fill);\\n        }\\n        rgb = hexToRgb(fill);\\n        if( !rgb ){\\n            is3d = false;\\n            var fill = jQuery(this).attr(\\\"fill\\\");\\n            if (typeof fill === \\\"string\\\" && !fill.startsWith(\\\"#\\\")) {\\n                fill = colorNameToHex(fill);\\n            }\\n            rgb = hexToRgb(fill);\\n        }\\n\\n        //Brighter color\\n        rgb.r = parseInt(255-(255-rgb.r)/2);\\n        rgb.g = parseInt(255-(255-rgb.g)/2);\\n        rgb.b = parseInt(255-(255-rgb.b)/2);\\n        if( !is3d ){\\n            jQuery(this).attr(\\\"fill\\\", rgbToHex(rgb.r, rgb.g, rgb.b));\\n        }\\n        else {\\n            jQuery(this).find(\\\">:first-child\\\").attr(\\\"fill\\\", rgbToHex(rgb.r, rgb.g, rgb.b));\\n        }\\n    });\\n}\\n\\nfunction unhighlight(section){\\n    jQuery.each(section.children(), function(){\\n        var is3d = true;\\n        var fill = jQuery(this).find(\\\">:first-child\\\").attr(\\\"fill\\\");\\n        if (typeof fill === \\\"string\\\" && !fill.startsWith(\\\"#\\\")) {\\n            fill = colorNameToHex(fill);\\n        }\\n        rgb = hexToRgb(fill);\\n        if( !rgb ){\\n            is3d = false;\\n            var fill = jQuery(this).attr(\\\"fill\\\");\\n            if (typeof fill === \\\"string\\\" && !fill.startsWith(\\\"#\\\")) {\\n                fill = colorNameToHex(fill);\\n            }\\n            rgb = hexToRgb(fill);\\n        }\\n        //Darker color\\n        rgb.r = parseInt(rgb.r*2-255) >= 0 ? parseInt(rgb.r*2-255) : 0;\\n        rgb.g = parseInt(rgb.g*2-255) >= 0 ? parseInt(rgb.g*2-255) : 0;\\n        rgb.b = parseInt(rgb.b*2-255) >= 0 ? parseInt(rgb.b*2-255) : 0;\\n        if( !is3d ){\\n            jQuery(this).attr(\\\"fill\\\", rgbToHex(rgb.r, rgb.g, rgb.b));\\n        }\\n        else {\\n            jQuery(this).find(\\\">:first-child\\\").attr(\\\"fill\\\", rgbToHex(rgb.r, rgb.g, rgb.b));\\n        }\\n    });\\n}\\n\\nfunction rgbToHex(r, g, b) {\\n    return \\\"#\\\" + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);\\n}\\n\\nfunction hexToRgb(hex){\\n    var result = /^#?([a-f\\\\d]{2})([a-f\\\\d]{2})([a-f\\\\d]{2})$/i.exec(hex);\\n\\n    return result? {\\n        r: parseInt(result[1], 16),\\n        g: parseInt(result[2], 16),\\n        b: parseInt(result[3], 16)\\n    } : null;\\n}\\n\\nfunction areaTicket(id, type){\\n    var areaInfo = zone[id];\\n    if (id != selSec && areaInfo && areaInfo.areaStatus != \\\"UNAVAILABLE\\\") {\\n        if(selSec!=\\\"\\\"){\\n            $(\\\"#\\\" + selSec).removeClass(\\\"selected\\\");\\n            if(type == \\\"map\\\"){\\n                unhighlight($(\\\"#\\\" + selSec));\\n            }\\n        }\\n        selSec = id;\\n        $(\\\"#\\\" + selSec).addClass(\\\"selected\\\");\\n        $(\\\"#priceList\\\").html(\\\"<img id=\\\\\\\"loadingmap\\\\\\\" src=\\\\\\\"/images/loading.GIF\\\\\\\" alt=\\\\\\\"loadingmap\\\\\\\">\\\");\\n\\n        let areaUrl = new URL(areaInfo.areaUrl);\\n\\n        \\n\\n        $.ajax({\\n            type: \\\"GET\\\",\\n            url: areaUrl.toString(),\\n            success: function(response) {\\n                $(\\\"#priceList\\\").html(response);\\n                $(\\\"#groupName\\\").html(areaInfo.groupName)\\n            },\\n            error: function(xhr){\\n                if(xhr.responseJSON){\\n                    alert(xhr.responseJSON.message);\\n                }\\n                $(\\\"#priceList\\\").html(\\\"\\\");\\n            }\\n        });\\n\\n        if (Object.keys(zone).length != 1) {\\n            jQuery(\\\"body,html\\\").animate({\\n                scrollTop: $(\\\"div#priceList\\\").offset().top-$(\\\"#header\\\").outerHeight()\\n            }, 800);\\n        }\\n    }\\n}</script>\""},"headersSize":0,"bodySize":2578,"redirectURL":"","_transferSize":2578},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":621.769,"receive":0.556},"serverIPAddress":"151.101.193.237","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"ticketmaster.sg","issuer":"GlobalSign Atlas R3 DV TLS CA 2025 Q4","validFrom":1765077397,"validTo":1799378196}},{"pageref":"page@6c08b15844ae267c29cf0762d724c890","startedDateTime":"2026-05-20T02:06:23.612Z","time":599.322,"request":{"method":"GET","url":"https://ticketmaster.sg/images/loading.GIF","httpVersion":"HTTP/2.0","cookies":[{"name":"eps_sid",